# Sample environment configuration for typerelay-server (FreeBSD port)
# Copy to /usr/local/etc/typerelay-server.env and adjust for your deployment.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=production
TYPERELAY_APP=server
PORT=3000

# Public URLs
APP_URL=http://localhost:3040
API_BASE_URL=http://localhost:3000
MCP_BASE_URL=http://localhost:3041/mcp

# CORS / origin allow-lists
API_ALLOWED_ORIGINS=http://localhost:3040,http://localhost:3000
MCP_ALLOWED_ORIGINS=http://localhost:3040

# Secret for private API delegation / concurrency leases
JWT_SECRET=change-me-to-a-random-secret

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/typerelay?replicaSet=typerelay

# ---------------------------------------------------------------------------
# Memcached (for caching)
# ---------------------------------------------------------------------------
MEMCACHED_SERVERS=localhost:11211

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
API_RATE_LIMIT=1000
MCP_RATE_LIMIT=500

# ---------------------------------------------------------------------------
# OPTIONAL: Stripe billing (only if you intend to enable billing)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_ACTIVE=
# STRIPE_PRICE_ID_INACTIVE=

# ---------------------------------------------------------------------------
# OPTIONAL: SAML (enterprise authentication)
# ---------------------------------------------------------------------------
# SAML_ENTRYPOINT=
# SAML_ISSUER=
# SAML_IDENTIFIER=
